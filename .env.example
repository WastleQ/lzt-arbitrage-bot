# Telegram Bot Settings
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_ID=123456789

# LZT Market Settings
LZT_API_TOKEN=your_lzt_market_api_token_here
LZT_DEPOSIT_FEE_PERCENT=2.0
LZT_BUY_FEE_PERCENT=0.0
LZT_RESELL_FEE_PERCENT=5.0

# Bot Arbitrage Default Settings
MIN_PROFIT_RUB=100.0
MIN_ROI_PERCENT=25.0
AUTO_BUY_ENABLED=false
CHECK_INTERVAL_SECONDS=3.0

# Bot Safety and Warning Filters
MIN_SELLER_TRUST=0
MIN_ACCOUNT_AGE_DAYS=0
EXCLUDE_WORDS=откат,бан,нет почты

# Database
DB_PATH=data/arbitrage.db

# Auto-Buy Safety
MAX_AUTO_BUY_PRICE=0.0
CONFIRM_ABOVE_PRICE=0.0
SEEN_COOLDOWN_MINUTES=30
MIN_BALANCE_ALERT=100.0

# LZT API Rate Limit (token bucket)
RATE_LIMIT_RPS=2.0
RATE_LIMIT_BURST=5
REQUEST_RETRIES=4
REQUEST_BACKOFF_BASE=1.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/bot.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# Categories (comma-separated) and weights config file
ENABLED_CATEGORIES=minecraft,brawlstars,valorant
CATEGORIES_CONFIG_PATH=categories.yaml
